let products=[],cart=JSON.parse(localStorage.getItem("tm-cart")||"[]");const $=id=>document.getElementById(id);async function init(){products=await fetch("/api/products").then(r=>r.json());render();cartRender()}function render(a=products){$("grid").innerHTML=a.map(p=>`<article class="card"><div class="pic">${p.icon}</div><div class="body"><span class="cat">${p.category}</span><h3>${p.name}</h3><div class="price">$${p.price.toFixed(2)} ${p.oldPrice?`<span class="old">$${p.oldPrice.toFixed(2)}</span>`:""}</div><button class="btn add" onclick="add('${p.id}')">Agregar</button></div></article>`).join("")}function save(){localStorage.setItem("tm-cart",JSON.stringify(cart));cartRender()}function add(id){let x=cart.find(a=>a.id===id);x?x.qty++:cart.push({id,qty:1});save();openCart()}function ch(id,d){let x=cart.find(a=>a.id===id);x.qty+=d;if(x.qty<1)cart=cart.filter(a=>a.id!==id);save()}function cartRender(){let t=0;$("count").textContent=cart.reduce((s,a)=>s+a.qty,0);$("items").innerHTML=cart.length?cart.map(a=>{let p=products.find(x=>x.id===a.id);t+=p.price*a.qty;return`<div class="item"><span><b>${p.name}</b><br>$${p.price.toFixed(2)}</span><span class="qty"><button onclick="ch('${p.id}',-1)">−</button>${a.qty}<button onclick="ch('${p.id}',1)">+</button></span></div>`}).join(""):"Carrito vacío";$("total").textContent=t.toFixed(2)}function openCart(){$("drawer").classList.add("open");$("shade").classList.add("show")}function closeCart(){$("drawer").classList.remove("open");$("shade").classList.remove("show")}$("open").onclick=openCart;$("close").onclick=closeCart;$("shade").onclick=closeCart;$("search").oninput=e=>{let q=e.target.value.toLowerCase();render(products.filter(p=>(p.name+" "+p.category).toLowerCase().includes(q)))}async function createOrder(){let r=await fetch("/api/orders",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:cart,customer:{name:$("name").value,phone:$("phone").value,address:$("address").value}})});return [r.ok,await r.json()]}$("wa").onclick=async()=>{if(!cart.length)return alert("Carrito vacío");let[o,x]=await createOrder();if(!o)return alert(x.error);let lines=x.items.map(i=>`${i.qty} x ${i.name} - $${(i.qty*i.price).toFixed(2)}`).join("\n");window.open("https://wa.me/50760000000?text="+encodeURIComponent(`Hola Todomix, pedido ${x.id}\n${lines}\nTotal $${x.total.toFixed(2)}`))};$("pay").onclick=async()=>{if(!cart.length)return alert("Carrito vacío");let[o,x]=await createOrder();if(!o)return alert(x.error);let r=await fetch("/api/yappy/order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({orderId:x.id})});let y=await r.json();if(!r.ok)return alert(y.error||"Configura Yappy");$("yb").hidden=false;document.querySelector("btn-yappy").eventPayment({transactionId:y.body.transactionId,documentName:y.body.documentName,token:y.body.token})};init();
